pragma cashscript ^0.14.0;

// Veridom Retention vault - the warranty holdback ("Haftruecklass").
//
// A share of every released milestone lands here. After the warranty end
// date anybody may trigger the payout, but the covenant only lets the money
// go to the contractor. Before that date, the homeowner and the inspector can
// together use it to fix defects the contractor did not repair.
contract Retention(
    pubkey owner,
    pubkey contractor,
    pubkey inspector,
    int warrantyEnd,   // locktime (unix time or block height) when the warranty ends
    bytes32 termsHash
) {
    // Warranty is over: pay the contractor. No signature needed, so the
    // contractor can never be blocked by a silent homeowner. Each vault input
    // is paid out to the output with the same index (several can be batched).
    function claim() {
        require(tx.time >= warrantyEnd);
        require(termsHash.length == 32);
        int i = this.activeInputIndex;
        require(tx.outputs[i].lockingBytecode == new LockingBytecodeP2PKH(hash160(contractor)));
        require(tx.outputs[i].value >= tx.inputs[i].value);
        require(tx.outputs[i].tokenCategory == tx.inputs[i].tokenCategory);
        require(tx.outputs[i].tokenAmount == tx.inputs[i].tokenAmount);
    }

    // Defect found during the warranty, early settlement, or any other change:
    // any two of the three parties decide together.
    function cosign(pubkey first, sig firstSig, pubkey second, sig secondSig) {
        require(first != second);
        require(first == owner || first == contractor || first == inspector);
        require(second == owner || second == contractor || second == inspector);
        require(checkSig(firstSig, first));
        require(checkSig(secondSig, second));
    }
}
